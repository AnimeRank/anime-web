<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Información del anime - AnimeRank</title>

    <link rel="stylesheet" href="../estilo-pagina/style.css">

</head>


<body>


    <!-- ==========================================
         ANIMERANK - INFORMACIÓN DEL ANIME
         ========================================== -->


    <header class="cabecera">

        <div class="logo">
            AnimeRank
        </div>


        <nav class="menu-principal">

            <a href="../">🏠 Inicio</a>

            <a href="../buscador/">🔎 Buscador</a>

            <a href="../recomendados/">⭐ Recomendados</a>

            <a href="../populares/">🔥 Populares</a>

            <a href="../temporadas/">📅 Temporadas</a>

            <a href="../generos/">🎭 Géneros</a>

            <a href="../traductor/">🌐 Traductor</a>

        </nav>

    </header>



    <main>


        <!-- ==========================================
             FICHA DEL ANIME
             ========================================== -->


        <section class="ficha-pagina">

            <div id="ficha-anime">

                <p>
                    🔎 Cargando información del anime...
                </p>

            </div>

        </section>


    </main>



    <footer>

        <p>
            © 2026 AnimeRank - Buscador y guía de anime
        </p>

    </footer>



    <!-- ==========================================
         JAVASCRIPT DE INFORMACIÓN
         ========================================== -->


    <script>

        async function cargarAnime() {

            const parametros = new URLSearchParams(
                window.location.search
            );

            const id = parametros.get("id");

            const ficha = document.getElementById("ficha-anime");


            if (!id) {

                ficha.innerHTML = `
                    <p>
                        ❌ No se ha seleccionado ningún anime.
                    </p>
                `;

                return;

            }


            const query = `

                query ($id: Int) {

                    Media(id: $id, type: ANIME) {

                        id

                        title {
                            romaji
                            english
                            native
                        }

                        coverImage {
                            extraLarge
                        }

                        bannerImage

                        averageScore

                        popularity

                        episodes

                        duration

                        status

                        season

                        seasonYear

                        genres

                        studios {
                            nodes {
                                name
                            }
                        }

                        description(asHtml: false)

                    }

                }

            `;


            try {

                const respuesta = await fetch(
                    "https://graphql.anilist.co",
                    {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },

                        body: JSON.stringify({

                            query: query,

                            variables: {
                                id: Number(id)
                            }

                        })

                    }
                );


                const datos = await respuesta.json();

                const anime = datos.data.Media;


                if (!anime) {

                    ficha.innerHTML = `
                        <p>
                            ❌ No se encontró el anime.
                        </p>
                    `;

                    return;

                }


                const titulo =
                    anime.title.english ||
                    anime.title.romaji ||
                    anime.title.native ||
                    "Sin título";


                const puntuacion =
                    anime.averageScore
                    ? (anime.averageScore / 10).toFixed(1)
                    : "N/A";


                const descripcion =
                    anime.description
                    ? anime.description
                    : "No hay descripción disponible.";


                const estudio =
                    anime.studios.nodes.length > 0
                    ? anime.studios.nodes
                        .map(estudio => estudio.name)
                        .join(", ")
                    : "No disponible";


                ficha.innerHTML = `

                    <div class="ficha-anime">


                        <div class="imagen-anime">

                            <img
                                src="${anime.coverImage.extraLarge}"
                                alt="${titulo}"
                            >

                        </div>



                        <div class="datos-anime">


                            <h1>
                                ${titulo}
                            </h1>


                            ${
                                anime.title.romaji &&
                                anime.title.romaji !== titulo
                                ? `<p class="titulo-secundario">
                                    ${anime.title.romaji}
                                  </p>`
                                : ""
                            }


                            <div class="datos-principales">

                                <p>
                                    ⭐ <strong>${puntuacion}/10</strong>
                                </p>

                                <p>
                                    👥 Popularidad:
                                    ${anime.popularity || "N/A"}
                                </p>

                                <p>
                                    📅 ${anime.seasonYear || "Año desconocido"}
                                </p>

                                <p>
                                    🎬 ${anime.episodes || "?"} episodios
                                </p>

                                <p>
                                    ⏱️ ${anime.duration || "?"} min por episodio
                                </p>

                                <p>
                                    📺 ${anime.status || "Desconocido"}
                                </p>

                                <p>
                                    🎭 ${anime.genres.join(" • ")}
                                </p>

                                <p>
                                    🎨 Estudio: ${estudio}
                                </p>

                            </div>


                        </div>

                    </div>



                    <div class="sinopsis-anime">

                        <h2>
                            📖 Sinopsis
                        </h2>

                        <p>
                            ${descripcion}
                        </p>

                    </div>

                `;


                document.title =
                    titulo + " - AnimeRank";


            } catch (error) {

                console.error(error);

                ficha.innerHTML = `

                    <p>
                        ❌ No se pudo cargar la información.
                    </p>

                `;

            }

        }


        cargarAnime();

    </script>


</body>

</html>
